{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit --skipLibCheck",
    "test": "tsx test_credit_engine_reset.ts && tsx test_lipila_config.ts && tsx test_privacy_masking.ts && tsx test_backup_service.ts && tsx test_data_integrity.ts && tsx test_scale_load.ts && tsx test_remote_access_policy.ts && tsx test_pig_lifecycle.ts",
    "test:scale": "tsx test_scale_load.ts",
    "safeguard:pre": "tsx scripts/deploySafeguard.ts --pre",
    "safeguard:post": "tsx scripts/deploySafeguard.ts --post",
    "deploy:dev": "firebase use dev && firebase deploy",
    "deploy:staging": "firebase use staging && firebase deploy",
    "deploy:prod": "npm run backup:prod && firebase use production && firebase deploy --only hosting,functions",
    "backup:prod": "node scripts/backup-firestore.js production"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^3.10.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.16",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.1.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
